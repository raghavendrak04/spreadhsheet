# The app defaults to VITE_AI_PROVIDER=mock and needs no external key.
# For an OpenAI-compatible chat-completions endpoint, copy this file to
# .env.local and fill the values below. Never commit .env.local.
VITE_AI_PROVIDER=mock
VITE_AI_ENDPOINT=https://example.invalid/v1/chat/completions
VITE_AI_API_KEY=
VITE_AI_MODEL=
